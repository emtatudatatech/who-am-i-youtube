# Copy this file to .env and fill in real values. Never commit .env.
#
# This file holds only settings shared by EVERY person. Per-person database
# connection strings live in people/<person>.env — see people/emtatu.env.example
# and ONBOARDING.md.

# YouTube Data API v3 key (used by enrich_watch_history.py). Shared: one key
# enriches everyone's export.
YOUTUBE_API_KEY=

# So `pipelines.common` imports resolve when running scripts from the repo root.
PYTHONPATH=.

# Optional default for the --person flag on the pipelines and the local Node
# scripts. Falls back to 'emtatu' when unset.
# PERSON=emtatu
