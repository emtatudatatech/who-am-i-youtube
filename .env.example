# Copy this file to .env and fill in real values. Never commit .env.
# YouTube Data API v3 key (used by enrich_watch_history.py).
YOUTUBE_API_KEY=

# Neon Postgres connection string, e.g.
# postgresql://user:password@host.neon.tech/dbname?sslmode=require
DATABASE_URL=

# So `pipelines.common` imports resolve when running scripts from the repo root.
PYTHONPATH=.
