# Template for a person's env file. Copy to people/<person>.env and fill in.
#
#   cp people/emtatu.env.example people/wambui.env
#
# One file per person. It holds exactly one thing: the connection string for
# THAT person's Neon database. Because the pipelines pick this file from the
# --person flag, the dataset folder and the database can never be mismatched.
#
# Real people/*.env files are gitignored — never commit a connection string.
# The same value goes into that person's Netlify site as an environment
# variable (Site configuration → Environment variables → DATABASE_URL).
#
# See ONBOARDING.md.

DATABASE_URL="postgresql://USER:PASSWORD@HOST.neon.tech/DBNAME?sslmode=require"
